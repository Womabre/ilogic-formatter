{
  "name": "ilogic-formatter",
  "displayName": "iLogic Formatter",
  "description": "Formatter, outline, completion and convention hints for Autodesk Inventor iLogic rules (.iLogicVb)",
  "version": "1.10.0",
  "publisher": "Womabre",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Womabre/ilogic-formatter.git"
  },
  "bugs": {
    "url": "https://github.com/Womabre/ilogic-formatter/issues"
  },
  "homepage": "https://github.com/Womabre/ilogic-formatter#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters",
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "iLogic",
    "Inventor",
    "Autodesk",
    "VB.NET",
    "formatter",
    "iLogicVb",
    "Autodesk Inventor",
    "CAD",
    "snippets",
    "linter"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ilogicvb",
        "aliases": [
          "iLogic VB",
          "iLogicVb"
        ],
        "extensions": [
          ".iLogicVb"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "vb",
        "aliases": [
          "Visual Basic",
          "VB.NET"
        ],
        "extensions": [
          ".vb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ilogicvb",
        "scopeName": "source.ilogicvb",
        "path": "./syntaxes/ilogicvb.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ilogicFormatter.formatDocument",
        "title": "Format iLogic Rule",
        "category": "iLogic"
      }
    ],
    "configuration": {
      "title": "iLogic Formatter",
      "properties": {
        "ilogicFormatter.indentSize": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "maximum": 16,
          "description": "Number of spaces per indentation level. Leave empty (null) to use the editor's Tab Size for the file.",
          "scope": "language-overridable"
        },
        "ilogicFormatter.useTabs": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null,
          "description": "Use tabs instead of spaces for indentation. Leave empty (null) to follow the editor's Insert Spaces setting for the file.",
          "scope": "language-overridable"
        },
        "ilogicFormatter.maxBlankLines": {
          "type": "number",
          "default": 1,
          "description": "Maximum number of consecutive blank lines to allow.",
          "minimum": 0,
          "maximum": 100,
          "scope": "language-overridable"
        },
        "ilogicFormatter.blankLineAfterBlock": {
          "type": "boolean",
          "default": true,
          "description": "Insert a blank line after End Sub / End Function / End Property.",
          "scope": "language-overridable"
        },
        "ilogicFormatter.normalizeKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Normalize VB.NET keyword casing (e.g. dim → Dim, if → If).",
          "scope": "language-overridable"
        },
        "ilogicFormatter.normalizeComments": {
          "type": "boolean",
          "default": true,
          "description": "Ensure a space after the comment apostrophe (e.g. 'comment → ' comment).",
          "scope": "language-overridable"
        },
        "ilogicFormatter.normalizeUnicode": {
          "type": "boolean",
          "default": true,
          "description": "Replace lookalike Unicode characters in code with their ASCII equivalents (e.g. en dash → hyphen, curly quote delimiters → straight quotes). String literals and comment text are never changed.",
          "scope": "language-overridable"
        },
        "ilogicFormatter.formatVbFiles": {
          "type": "boolean",
          "default": true,
          "description": "Also format .vb files. Turn off if you work on regular VB.NET projects and want another formatter for them.",
          "scope": "window"
        },
        "ilogicFormatter.warnUnbalancedBlocks": {
          "type": "boolean",
          "default": true,
          "description": "Show warnings for unbalanced blocks: End If without If, a Sub or If that is never closed, Else or Case outside its block.",
          "scope": "language-overridable"
        },
        "ilogicFormatter.disabledHints": {
          "type": "array",
          "default": [],
          "scope": "language-overridable",
          "items": {
            "type": "string",
            "enum": [
              "interpolation",
              "empty-catch",
              "msgbox",
              "option-strict"
            ],
            "enumDescriptions": [
              "$\"...\" strings (not supported in iLogic)",
              "Catch blocks that discard the exception",
              "MsgBox / MessageBox.Show used for messages instead of Logger",
              "Rules without Option Strict On"
            ]
          },
          "description": "iLogic convention hints to turn off (shown for .iLogicVb files)."
        }
      }
    },
    "configurationDefaults": {
      "[ilogicvb]": {
        "editor.formatOnType": true
      }
    },
    "snippets": [
      {
        "language": "ilogicvb",
        "path": "./snippets/ilogicvb.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "bun test",
    "package": "npm run compile && vsce package --out ilogic-formatter.vsix",
    "grammar": "bun scripts/build-grammar.ts",
    "format": "bun src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "bin": {
    "ilogic-format": "./out/cli.js"
  }
}
