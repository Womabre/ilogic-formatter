{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "iLogic VB",
  "scopeName": "source.ilogicvb",
  "fileTypes": [
    "iLogicVb"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.ilogicvb",
          "match": "'.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ilogicvb",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ilogicvb",
          "match": "\"\""
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ilogicvb",
          "match": "(?i)\\b(Continue|SyncLock|Finally|ElseIf|Select|Return|Resume|While|Until|Gosub|Catch|Throw|Yield|Await|Error|Using|Then|Else|Each|Step|Next|Loop|Case|Exit|GoTo|Wend|When|Stop|Call|With|End|For|Try|If|In|To|Do|On)\\b"
        },
        {
          "name": "keyword.declaration.ilogicvb",
          "match": "(?i)\\b(Implements|Structure|Interface|Namespace|Function|Property|Delegate|Operator|Preserve|Inherits|Explicit|Declare|Unicode|Imports|Handles|Compare|Module|Option|Strict|Class|Event|Alias|Const|ReDim|Erase|Infer|Enum|Ansi|Sub|Get|Set|Lib|Dim|Let|New|Off|As|Of)\\b"
        },
        {
          "name": "keyword.modifier.ilogicvb",
          "match": "(?i)\\b(NotOverridable|NotInheritable|MustOverride|Overridable|MustInherit|WithEvents|ParamArray|Protected|WriteOnly|Overrides|Overloads|Narrowing|ReadOnly|Widening|Iterator|Optional|Private|Shadows|Partial|Default|Public|Friend|Shared|Static|Async|ByVal|ByRef|Out)\\b"
        },
        {
          "name": "keyword.operator.word.ilogicvb",
          "match": "(?i)\\b(GetXmlNamespace|RemoveHandler|DirectCast|AddHandler|RaiseEvent|AddressOf|AndAlso|GetType|IsFalse|TryCast|CUShort|OrElse|TypeOf|NameOf|IsTrue|CSByte|CShort|IsNot|CType|CBool|CByte|CChar|CDate|CUInt|CULng|Like|CDbl|CDec|CInt|CLng|CObj|CSng|CStr|And|Not|Xor|Mod|Or|Is)\\b"
        },
        {
          "name": "storage.type.ilogicvb",
          "match": "(?i)\\b(UInteger|Boolean|Integer|Decimal|Variant|UShort|Single|Double|String|Object|SByte|Short|ULong|Byte|Long|Char|Date)\\b"
        },
        {
          "name": "constant.language.ilogicvb",
          "match": "(?i)\\b(Nothing|False|True)\\b"
        },
        {
          "name": "variable.language.ilogicvb",
          "match": "(?i)\\b(MyClass|MyBase|Global|Me)\\b"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.ilogicvb",
      "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.ilogicvb",
      "match": "\\+|-|\\*|\\/|\\\\|\\^|&|=|<>|<=|>=|<|>|\\."
    }
  }
}
