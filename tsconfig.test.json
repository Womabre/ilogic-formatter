{
    // Type-checks the tests and scripts, which bun runs without checking.
    // Nothing is emitted; the extension itself is built from tsconfig.json.
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "lib": ["ES2022"],
        "types": ["bun", "node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["src/**/*", "test/**/*", "scripts/**/*"]
}
